<script>
const dict = {
"میرا":"Mera","میری":"Meri","میرے":"Mere","نام":"naam","ہے":"hai","ہوں":"hun","ہو":"ho","ہیں":"hain",
"مجھے":"Mujhe","تمہیں":"Tumhe","اسے":"Ise","اس":"Is","یہ":"Ye","وہ":"Wo","کیا":"Kya","کیوں":"Kyun",
"کہانیاں":"kahaniyan","کہانی":"kahani","پڑھنا":"parhna","پسند":"pasand","بہت":"bohat","اچھا":"acha",
"اچھے":"ache","برا":"bura","دل":"dil","دنیا":"duniya","زندگی":"zindagi","محبت":"mohabbat","دوست":"dost",
"گھر":"ghar","پانی":"pani","کھانا":"khana","آج":"aaj","کل":"kal","اب":"ab","پھر":"phir","کب":"kab",
"کہاں":"kahan","کون":"kon","کبھی":"kabhi","ہمیشہ":"hamesha","پیار":"pyar","خوش":"khush","غم":"gham",
"رات":"raat","دن":"din","صبح":"subah","شام":"shaam","سکول":"school","کتاب":"kitab","لڑکی":"larki","لڑکا":"larka",
"بھائی":"bhai","بہن":"behen","امی":"ami","ابو":"abu","ماں":"maa","باپ":"baap","اللہ":"Allah","شکریہ":"shukriya",
"معاف":"maaf","کیسے":"kaise","ٹھیک":"theek","چلو":"chalo","آؤ":"aao","جاؤ":"jao","کھیل":"khel",
"خوفناک":"khofnak","بھوت":"bhoot","ڈر":"dar","خواب":"khawab","یاد":"yaad","بات":"baat","سچ":"sach","جھوٹ":"jhoot"
};
function convert(){
  let text = document.getElementById("urduInput").value.trim();
  if(!text){ document.getElementById("output").innerText = "Pehle upar Urdu me kuch likho..."; return; }
  let words = text.split(/\s+/);
  let roman = words.map(w => {
    let clean = w.replace(/[۔،؟!.,]/g,"");
    if(dict[clean]) return dict[clean];
    if(dict[w]) return dict[w];
    return w;
  }).join(" ");
  document.getElementById("output").innerText = roman;
  let romanWords = roman.split(/\s+/).filter(x=>x.length>0);
  document.getElementById("words").innerText = "Words: " + romanWords.length;
  document.getElementById("chars").innerText = "Letters: " + roman.replace(/\s/g,"").length;
}
function copyText(){
  let t = document.getElementById("output").innerText;
  navigator.clipboard.writeText(t);
  alert("Copy ho gaya! Ab WhatsApp pe paste kar do.");
}
</script>
